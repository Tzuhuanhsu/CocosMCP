{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "cocos-mcp-server",
    "version": "2.0.0",
    "author": "LiDaxian",
    "editor": ">=3.8.3",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build": "tsc && node inspector/build.js",
        "build:server": "tsc",
        "build:inspector": "node inspector/build.js",
        "watch": "tsc -w",
        "typecheck:inspector": "tsc -p inspector/tsconfig.json",
        "pack": "node ./scripts/pack-dist.js"
    },
    "description": "i18n:cocos-mcp-server.description",
    "main": "./dist/main.js",
    "dependencies": {
        "fs-extra": "^11.3.0",
        "uuid": "^9.0.1",
        "vue": "^3.1.4"
    },
    "devDependencies": {
        "@cocos/creator-types": "3.8.3",
        "@types/fs-extra": "^9.0.5",
        "@types/node": "^18.17.1",
        "@types/uuid": "^9.0.8",
        "esbuild": "^0.28.2",
        "typescript": "^5.8.2"
    },
    "panels": {
        "default": {
            "title": "i18n:cocos-mcp-server.panel_title",
            "type": "dockable",
            "main": "dist/panels/default",
            "icon": "./static/icon.png",
            "size": {
                "min-width": 400,
                "min-height": 300,
                "width": 600,
                "height": 500
            }
        }
    },
    "contributions": {
        "menu": [
            {
                "path": "i18n:menu.extension/Cocos MCP Server",
                "label": "i18n:cocos-mcp-server.open_panel",
                "message": "open-panel"
            },
            {
                "path": "i18n:menu.extension/Cocos MCP Server",
                "label": "i18n:cocos-mcp-server.start_server",
                "message": "start-server"
            },
            {
                "path": "i18n:menu.extension/Cocos MCP Server",
                "label": "i18n:cocos-mcp-server.stop_server",
                "message": "stop-server"
            },
            {
                "path": "i18n:menu.extension/Cocos MCP Server",
                "label": "i18n:cocos-mcp-server.inspector_preview",
                "message": "previewMode"
            },
            {
                "path": "i18n:menu.extension/Cocos MCP Server",
                "label": "i18n:cocos-mcp-server.inspector_build_mobile",
                "message": "buildMobileMode"
            },
            {
                "path": "i18n:menu.extension/Cocos MCP Server",
                "label": "i18n:cocos-mcp-server.inspector_build_desktop",
                "message": "buildDesktopMode"
            },
            {
                "path": "i18n:menu.extension/Cocos MCP Server",
                "label": "i18n:cocos-mcp-server.inspector_custom_page",
                "message": "openCustomPage"
            }
        ],
        "messages": {
            "open-panel": {
                "methods": [
                    "openPanel"
                ]
            },
            "start-server": {
                "methods": [
                    "startServer"
                ]
            },
            "stop-server": {
                "methods": [
                    "stopServer"
                ]
            },
            "get-server-status": {
                "methods": [
                    "getServerStatus"
                ]
            },
            "update-settings": {
                "methods": [
                    "updateSettings"
                ]
            },
            "getToolsList": {
                "methods": [
                    "getToolsList"
                ]
            },
            "get-server-settings": {
                "methods": [
                    "getServerSettings"
                ]
            },
            "previewMode": {
                "methods": [
                    "previewMode"
                ]
            },
            "buildMobileMode": {
                "methods": [
                    "buildMobileMode"
                ]
            },
            "buildDesktopMode": {
                "methods": [
                    "buildDesktopMode"
                ]
            },
            "openCustomPage": {
                "methods": [
                    "openCustomPage"
                ]
            }
        },
        "scene": {
            "script": "./dist/scene.js",
            "methods": [
                "createNewScene",
                "addComponentToNode",
                "removeComponentFromNode",
                "getNodeInfo",
                "getAllNodes",
                "findNodeByName",
                "setNodeProperty",
                "setComponentProperty",
                "getCurrentSceneInfo",
                "getSceneHierarchy",
                "createPrefabFromNode",
                "executeScript"
            ]
        }
    }
}
